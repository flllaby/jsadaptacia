
CREATE TABLE users (
    id SERIAL PRIMARY KEY,
    full_name VARCHAR(150) NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    login VARCHAR(100) UNIQUE NOT NULL,
    password_hash TEXT NOT NULL,
    role VARCHAR(50) CHECK (role IN ('admin', 'moderator', 'user')) DEFAULT 'user',
    coolness_score INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE cool_actions (
    id SERIAL PRIMARY KEY,
    title VARCHAR(200) NOT NULL,
    description TEXT,
    user_id INT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    coolness_points INT CHECK (coolness_points BETWEEN 1 AND 100),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE cool_schedules (
    id SERIAL PRIMARY KEY,
    activity_title VARCHAR(200) NOT NULL,
    start_time TIMESTAMP NOT NULL,
    location VARCHAR(150)
);

CREATE TABLE mentors (
    id SERIAL PRIMARY KEY,
    user_id INT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    expertise VARCHAR(100)
);

CREATE TABLE schedule_mentors (
    id SERIAL PRIMARY KEY,
    schedule_id INT NOT NULL REFERENCES cool_schedules(id) ON DELETE CASCADE,
    mentor_id INT NOT NULL REFERENCES mentors(id) ON DELETE CASCADE,
    UNIQUE(schedule_id, mentor_id)
);

