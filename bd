SELECT login, full_name, coolness_score FROM users ORDER BY coolness_score DESC;

SELECT a.title, a.description, u.login, a.coolness_points 
FROM cool_actions a
JOIN users u ON a.user_id = u.id
ORDER BY a.coolness_points DESC;

SELECT cs.activity_title, cs.start_time, cs.location, u.login AS mentor_name, m.expertise
FROM schedule_mentors sm
JOIN cool_schedules cs ON sm.schedule_id = cs.id
JOIN mentors m ON sm.mentor_id = m.id
JOIN users u ON m.user_id = u.id
ORDER BY cs.start_time;
